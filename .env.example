# Supabase — server-side only (never expose to client)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Studio — UUID of the studio this deployment serves
DEPLOYMENT_STUDIO_ID=

# Upload handle encryption — server-side only, never expose to client.
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Rotating this invalidates all in-flight upload handles (visitors mid-form must
# re-add images); blast radius is bounded by the handle TTL (~2h).
UPLOAD_TOKEN_SECRET=

# Upstash Redis (REST) — server-side only. Backs the durable per-IP upload quota on
# POST /api/upload (bff/uploadQuota.ts). Provision an Upstash Redis database (Vercel
# Marketplace or native Upstash) and copy its REST URL + token here.
# These are REQUIRED: if unset, config (requireEnv) throws at import and /api/upload cannot
# serve — it denies by default rather than running unbounded. (Once set, a store that is
# reachable-but-erroring at runtime fails closed with a 503 and no storage write — the quota
# is never silently disabled.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
